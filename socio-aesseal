async function enviar(){
  // Esperar a que la configuración esté cargada
  if (!configLoaded) {
    await loadConfig();
  }
  
  const inp=document.getElementById('cin');
  const msg=inp.value.trim(); if(!msg) return;
  const btn=document.getElementById('bta');
  btn.disabled=true; btn.textContent='Analizando...';
  inp.value='';
  const ms=document.getElementById('cmsgs');
  const ud=document.createElement('div'); ud.className='mu'; ud.textContent=msg;
  ms.appendChild(ud);
  const ag=AGS[curAg];
  const td=document.createElement('div'); td.className='mt'; td.id='thk';
  td.innerHTML=`<div class="spinner"></div>${ag.n} analizando...`;
  ms.appendChild(td); ms.scrollTop=ms.scrollHeight;
  try{
    const r=await fetch(GU,{method:'POST',headers:{'Authorization':`Bearer ${GK}`,'Content-Type':'application/json'},
      body:JSON.stringify({model:'llama-3.3-70b-versatile',
        messages:[{role:'system',content:`${ag.s}\n\nCONTEXTO:\n${CTX}\n\nNUNCA menciones otras unidades de negocio ni datos internos de AdSmart o facturación global.`},
          ...hist.slice(-6),{role:'user',content:msg}],
        max_tokens:500,temperature:0.35})});
    if(!r.ok) throw new Error(`HTTP ${r.status}`);
    const d=await r.json(); if(d.error) throw new Error(d.error.message);
    const rep=d.choices?.[0]?.message?.content||'Sin respuesta';
    document.getElementById('thk')?.remove();
    const ad=document.createElement('div'); ad.className='ma';
    ad.innerHTML=`<div class="mh"><div style="width:22px;height:22px;border-radius:3px;background:${ag.cs}18;border:1px solid ${ag.cs}55;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:${ag.cs};font-family:'Barlow Condensed',sans-serif;">${ag.i}</div><span style="color:${ag.cs};">${ag.n}</span><span style="color:var(--muted);font-size:11px;">${ag.r}</span><span style="margin-left:auto;font-size:11px;color:var(--muted);">${new Date().toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'})}</span></div><div style="white-space:pre-wrap;">${rep}</div>`;
    ms.appendChild(ad); ms.scrollTop=ms.scrollHeight;
    hist.push({role:'user',content:msg},{role:'assistant',content:rep});
    await fetch(`${SU}/rest/v1/agent_sessions`,{method:'POST',headers:{'apikey':SK,'Authorization':`Bearer ${SK}`,'Content-Type':'application/json','Prefer':'return=minimal'},body:JSON.stringify({agent:curAg,user_message:msg,agent_response:rep,context_used:{project:'aesseal_2026',view:'socio_aesseal'}})});
  }catch(e){
    document.getElementById('thk')?.remove();
    const ed=document.createElement('div'); ed.className='ma';
    ed.innerHTML=`<div style="color:var(--red);font-size:13px;">Error: ${e.message}</div>`;
    ms.appendChild(ed);
  }
  btn.disabled=false; btn.textContent='ANALIZAR →';
  ms.scrollTop=ms.scrollHeight;
}

async function buscar(){
  // Esperar a que la configuración esté cargada
  if (!configLoaded) {
    await loadConfig();
  }
  
  const btn=document.getElementById('btn-licit');
  btn.disabled=true; btn.textContent='Detectando...';
  document.getElementById('lem').style.display='none';
  document.getElementById('lload').style.display='block';
  document.getElementById('lres').innerHTML='';
  try{
    const r=await fetch(GU,{method:'POST',headers:{'Authorization':`Bearer ${GK}`,'Content-Type':'application/json'},
      body:JSON.stringify({model:'llama-3.3-70b-versatile',
        messages:[{role:'system',content:'Solo JSON array válido, sin markdown.'},
          {role:'user',content:`Identificá 8 proyectos reales o altamente probables en Argentina y Latinoamérica en Petróleo & Gas, Minería, Química, Refinación o Procesamiento para 2026 que requieran sellos mecánicos, protectores de rodamientos o sistemas de soporte. Para cada proyecto, incluí la FECHA ESTIMADA DE APERTURA/CIERRE de la oportunidad. JSON: [{"proyecto":"nombre","empresa_cliente":"quien ejecuta el proyecto","tipo":"tipo de planta/proceso","producto_requerido":"sello API 682/protector rodamiento/sistema Plan 53B/etc.","valor_estimado":"USD X","estado":"EN LICITACIÓN/ADJUDICADO/PRÓXIMO","fecha_apertura":"DD/MM/YYYY o Mes/YYYY","decisor":"cargo del decisor","oportunidad":"por qué AESSEAL debe participar"}]`}],
        max_tokens:2500,temperature:0.3})});
    const d=await r.json();
    const txt=d.choices?.[0]?.message?.content||'[]';
    const m=txt.replace(/```json|```/g,'').trim().match(/\[[\s\S]*\]/);
    const items=m?JSON.parse(m[0]):[];
    document.getElementById('lload').style.display='none';
    document.getElementById('lres').innerHTML=items.map(p=>`
      <div class="li">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px;margin-bottom:6px;">
          <div><div class="ln">${p.proyecto}</div><div class="lm">${p.empresa_cliente} · ${p.tipo} · Decisor: ${p.decisor}</div></div>
          <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
            <span class="bdg ${p.estado.includes('LICITACIÓN')?'do':'dg'}">${p.estado}</span>
            <span class="bdg db">${p.valor_estimado}</span>
          </div>
        </div>
        <div class="ld">${p.oportunidad}<br><strong style="color:var(--azure);">Producto: ${p.producto_requerido}</strong></div>
        <div class="ldate">📅 Apertura: ${p.fecha_apertura}</div><br>
        <button onclick="document.getElementById('cin').value='Armame una propuesta para ${p.empresa_cliente.replace(/'/g,"\\'")} para el proyecto ${p.proyecto.replace(/'/g,"\\'")} que requiere ${p.producto_requerido}';show('mesa',document.querySelectorAll('.nb')[2]);" style="font-size:11px;background:rgba(74,158,232,0.1);border:1px solid rgba(74,158,232,0.3);color:var(--azure);padding:5px 12px;cursor:pointer;border-radius:3px;">→ Crear propuesta con AI</button>
      </div>`).join('');
    document.getElementById('act-radar').style.display='block';
  }catch(e){
    document.getElementById('lload').style.display='none';
    document.getElementById('lem').style.display='block';
    document.getElementById('lem').textContent='Error al detectar oportunidades. Intentá de nuevo.';
  }
  btn.disabled=false; btn.textContent='🔍 OPORTUNIDADES DETECTADAS';
}

